# ---- LLM endpoints ----
VLLM_API_BASE=http://localhost:8801/v1
VLLM_API_KEY="changeme"
VLLM_MODEL_NAME=Qwen/Qwen3-8B
VLLM_EMBEDDING_API_BASE=http://localhost:8881/v1
VLLM_EMBEDDING_NAME=BAAI/bge-m3

# ---- Agent storage and policy ----
AGENT_RUNS_DIR=/scratch/${USER}/hpc-agent/runs
AGENT_CACHE_DIR=/scratch/${USER}/hpc-agent/cache
AGENT_FAISS_INDEX_PATH=/opt/hpc-agent/faiss/index.faiss
AGENT_ALLOWLIST_PATH=./config/allowlist.yml
AGENT_DEFAULT_DRY_RUN=true
AGENT_LOG_LEVEL=INFO
